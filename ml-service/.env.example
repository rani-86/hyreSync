GROQ_API_KEY=your_groq_api_key

# Optional: enables the semantic signal in hybrid fit scoring via the hosted
# Gemini embeddings API. If unset (or the API fails), scoring falls back to
# lexical TF-IDF + skill overlap only — the app still works either way.
GEMINI_API_KEY=your_gemini_api_key

# Shared secret with the Node server; required on all non-health routes,
# and sent back to the server when pulling the job corpus
ML_INTERNAL_KEY=choose_a_long_random_string

# Node server base URL, used to lazily pull the job corpus if this service
# restarts with an empty index (Render free tier spins down on inactivity)
SERVER_URL=your_deployed_server_url
